{
  "name": "codex-oss-lens",
  "version": "1.6.1",
  "description": "Local-first usage and workflow dashboard for OpenAI Codex session logs.",
  "type": "module",
  "bin": {
    "codex-oss-lens": "src/cli.js"
  },
  "files": [
    "src/",
    "public/",
    "application/",
    "docs/",
    "examples/*.json",
    "examples/*.md",
    "examples/*.html",
    "examples/dashboard-preview.png",
    "examples/dashboard-mobile-preview.png",
    "examples/brief-sample/",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "ROADMAP.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "scripts": {
    "pack:check": "npm pack --dry-run",
    "pack:smoke": "node scripts/smoke-pack.js",
    "evidence": "node src/cli.js public-evidence --out examples/public-evidence.sample.json --markdown examples/public-evidence.sample.md",
    "evidence:sample": "node scripts/check-public-evidence-sample.js",
    "evidence:links": "node scripts/check-public-links.js",
    "application:status": "node scripts/check-application-status.js",
    "application:evidence": "node scripts/check-application-evidence-matrix.js",
    "reviewer:faq": "node scripts/check-application-review-faq.js",
    "submission:risk": "node scripts/check-submission-risk-register.js",
    "submission:decision": "node scripts/check-submission-decision-summary.js",
    "submission:activity": "node scripts/check-submission-activity-log.js",
    "reviewer:quickstart": "node scripts/check-reviewer-quickstart.js",
    "reviewer:signedout": "node scripts/check-signed-out-review.js",
    "submitter:handoff": "node scripts/check-submitter-handoff.js",
    "form-draft:sample": "node scripts/check-form-draft-sample.js",
    "publish:samples": "node scripts/check-publish-samples.js",
    "publish:docs": "node scripts/check-publishing-docs.js",
    "dashboard:readiness": "node scripts/check-dashboard-readiness.js",
    "ci:readiness": "node scripts/check-ci-readiness.js",
    "contrib:readiness": "node scripts/check-contribution-readiness.js",
    "security:readiness": "node scripts/check-security-readiness.js",
    "support:readiness": "node scripts/check-support-readiness.js",
    "conduct:readiness": "node scripts/check-conduct-readiness.js",
    "license:readiness": "node scripts/check-license-readiness.js",
    "issue-routing:readiness": "node scripts/check-issue-routing-readiness.js",
    "release:provenance": "node scripts/check-release-provenance-readiness.js",
    "adoption:readiness": "node scripts/check-adoption-readiness.js",
    "adoption:snapshot": "node scripts/check-adoption-snapshot.js",
    "maintenance:readiness": "node scripts/check-maintenance-readiness.js",
    "maintainer:handoff": "node scripts/check-maintainer-handoff-readiness.js",
    "scope:limitations": "node scripts/check-scope-limitations-readiness.js",
    "privacy:threat-model": "node scripts/check-privacy-threat-model.js",
    "accessibility:readiness": "node scripts/check-accessibility-readiness.js",
    "data:retention": "node scripts/check-data-retention-readiness.js",
    "demo:walkthrough": "node scripts/check-demo-walkthrough-readiness.js",
    "submission:rehearsal": "node scripts/check-submission-rehearsal.js",
    "final-copy:check": "node scripts/check-final-copy.js",
    "public:redaction": "node scripts/check-public-redaction.js",
    "readme:badges": "node scripts/check-readme-badges.js",
    "readme:readiness": "node scripts/check-readme-readiness.js",
    "submission:check": "npm run final-copy:check && npm run submission:versions && npm run application:status && npm run application:evidence && npm run reviewer:faq && npm run submission:risk && npm run submission:decision && npm run submission:activity && npm run reviewer:quickstart && npm run reviewer:signedout && npm run submitter:handoff && npm run form-draft:sample && npm run publish:samples && npm run publish:docs && npm run dashboard:readiness && npm run ci:readiness && npm run contrib:readiness && npm run security:readiness && npm run support:readiness && npm run conduct:readiness && npm run license:readiness && npm run issue-routing:readiness && npm run release:provenance && npm run adoption:readiness && npm run adoption:snapshot && npm run maintenance:readiness && npm run maintainer:handoff && npm run scope:limitations && npm run privacy:threat-model && npm run accessibility:readiness && npm run data:retention && npm run demo:walkthrough && npm run submission:rehearsal && npm run public:redaction && npm run evidence:sample && npm run evidence:links && npm run readme:badges && npm run readme:readiness && npm test && npm run pack:check && npm run pack:smoke",
    "submission:versions": "node scripts/check-submission-versions.js",
    "scan": "node src/cli.js scan",
    "serve": "node src/cli.js serve",
    "test": "node --test"
  },
  "keywords": [
    "codex",
    "openai",
    "usage",
    "dashboard",
    "oss",
    "jsonl",
    "maintainer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbunk903/codex-oss-lens.git"
  },
  "homepage": "https://github.com/dbunk903/codex-oss-lens#readme",
  "bugs": {
    "url": "https://github.com/dbunk903/codex-oss-lens/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
